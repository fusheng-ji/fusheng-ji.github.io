---
layout: base.njk
permalink: /index.html
title: Wenbo Ji
description: Personal research portfolio for Wenbo Ji.
---
{% import "components/ui.njk" as ui with context %}

<header class="section-table hero-name-table">
  <div class="hero-name-cell">
    <h1 class="hero-name-line"><span class="site-name">Wenbo Ji&nbsp;&nbsp;&nbsp;<ruby class="name-ruby" lang="zh-Latn-pinyin">嵇<rt>jī / yí</rt></ruby>文博</span></h1>
  </div>
</header>

<section class="section-table hero-intro-table" aria-label="About Wenbo Ji">
  <div class="hero-bio-cell">
    {% for paragraph in hero.paragraphs %}
      <p class="{{ 'hero-phd-line' if loop.index == 3 }} {{ 'hero-background' if loop.index == 4 }}">{{ paragraph | safe }}</p>
    {% endfor %}
  </div>
  <div class="hero-media-cell">
    <div class="hero-media-layout">
      <div class="hero-media-row">
        <figure class="profile-portrait">{{ ui.image(site.owner.portrait, true, "profile-portrait-image") }}</figure>
      </div>
      <div class="avatar-icons" id="avatar-icons">
        {% for link in site.social %}
          <a href="{{ link.url }}" aria-label="{{ link.label }}" {% if link.external %}target="_blank" rel="noopener noreferrer"{% endif %}>
            <img src="{{ link.icon }}" alt="{{ link.label }}" width="28" height="28" decoding="async">
          </a>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<section class="section-table" id="news-table" aria-labelledby="news">
  <div class="section-cell" id="news-section">
    <div class="news-panel">
      <div class="news-panel-head"><h2 class="semantic-heading section-heading" id="news">News</h2></div>
      <div class="news-scroll" role="region" aria-label="News updates" tabindex="0">
        <div class="news-list">
          {% for item in news %}
            {% if loop.index <= 3 %}<article class="news-item"><time class="news-date">{{ item.date }}</time><p class="news-body">{{ item.body | safe }}</p></article>{% endif %}
          {% endfor %}
        </div>
        <details id="old_news" class="news-archive" open>
          <summary class="news-toggle">More news</summary>
          <div class="news-list news-list-archived">
            {% for item in news %}
              {% if loop.index > 3 %}<article class="news-item"><time class="news-date">{{ item.date }}</time><p class="news-body">{{ item.body | safe }}</p></article>{% endif %}
            {% endfor %}
          </div>
        </details>
      </div>
    </div>
  </div>
</section>

<section class="section-table" id="research-section" aria-labelledby="research">
  <div class="section-cell">
    <div class="research-interests-panel">
      <h2 class="semantic-heading section-heading" id="research">Research Interests</h2>
      <ol class="research-arc" aria-label="Research trajectory">
        {% for item in researchArc %}
          <li class="research-arc-item">
            <span class="research-arc-dot" aria-hidden="true"></span>
            <span class="research-arc-label">{{ item.label }}</span>
            <p class="research-arc-text">{{ item.text }}</p>
          </li>
        {% endfor %}
      </ol>
      <div class="research-tags" id="research-tags" role="list" aria-label="Research interest areas">
        {% for area in researchAreas %}{{ ui.researchTag(area.id, researchAreas, true) }}{% endfor %}
      </div>
    </div>
  </div>
</section>

<section id="publications-mount" aria-labelledby="Publications">
  {{ ui.sectionHeading("Publications", "Selected Publications", "* equal contribution, † corresponding author") }}
  {% for publication in publications %}{% include "components/publication.njk" %}{% endfor %}
</section>

<section id="experiences-mount" aria-labelledby="experiences">
  {{ ui.sectionHeading("experiences", "Experiences") }}
  {% for experience in experiences %}{% include "components/experience.njk" %}{% endfor %}
</section>

{% for document in documents %}{% include "components/document.njk" %}{% endfor %}

<section id="education-mount" aria-labelledby="education">
  {{ ui.sectionHeading("education", "Education") }}
  {% for item in education %}
    <article class="section-table experience-entry education-entry" id="education-{{ item.id }}">
      <div class="entry-media-cell">
        <div class="experience-logo-stack"><div class="experience-logo-card"><img src="{{ item.logo.src }}" width="{{ item.logo.width }}" height="{{ item.logo.height }}" loading="lazy" decoding="async" alt="{{ item.logo.alt }}"></div></div>
      </div>
      <div class="entry-content-cell">
        <p class="education-mobile-line">{{ item.degree }}</p>
        <div class="split-row"><h3 class="entry-title">{{ item.institution }}</h3><span class="text-right experience-side-meta"><span class="entry-meta">{{ item.date }}</span></span></div>
        <p class="education-degree">{{ item.degree }}</p>
        <p class="education-note">{{ item.note | safe }}</p>
      </div>
    </article>
  {% endfor %}
</section>

<section id="awards-mount" aria-labelledby="awards">
  {{ ui.sectionHeading("awards", "Selected Awards") }}
  {% for award in awards %}
    <article class="section-table experience-entry award-entry" id="award-{{ award.id }}">
      <div class="award-meta-cell"><time class="award-year">{{ award.date }}</time><span class="topic-location">{{ award.location }}</span></div>
      <div class="entry-content-cell"><div class="split-row"><h3 class="entry-title">{{ award.title }}</h3></div><div class="split-row experience-detail-row"><span class="experience-type">{{ award.type }}</span></div></div>
    </article>
  {% endfor %}
</section>

<section id="projects-mount" aria-labelledby="projects">
  {{ ui.sectionHeading("projects", "Projects") }}
  {% for project in projects %}{% include "components/project.njk" %}{% endfor %}
</section>

<section class="section-table blog-section-table" aria-labelledby="blog">
  <div class="section-cell">
    <div class="blog-panel">
      <div class="blog-header">
        <div class="blog-header-copy"><h2 class="semantic-heading section-heading" id="blog">Blog</h2><p class="blog-section-note">Thoughts on research, 3D, video generation, and the occasional in-between.</p></div>
        <a class="blog-view-all" href="/blog/">View all posts</a>
      </div>
      <div id="blog-list" class="blog-list" aria-live="polite">
        <div class="blog-error">Latest posts are available on the blog page.</div>
      </div>
    </div>
  </div>
</section>

{% include "components/gallery.njk" %}
