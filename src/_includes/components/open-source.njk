<section class="home-section" id="open-source-section" aria-labelledby="open-source" data-contributions>
  {{ ui.sectionHeading("open-source", "Open Source Contributions") }}
  <div class="section-cell">
    <div class="contributions-panel">
      <div class="contributions-list" id="contributions-list">
        {% for repository in openSource.repositoryGroups %}
          <article class="section-table experience-entry contribution-repository" data-contribution-repository="{{ repository.name }}">
            <div class="entry-media-cell">
              <div class="contribution-media-stack">
                <div class="contribution-logo">
                  {% set media = openSource.repositoryMedia[repository.name] %}
                  {% if media %}
                    {{ ui.image(media) }}
                  {% else %}
                    <span class="contribution-logo-fallback type-entry-title">{{ repository.label | escape }}</span>
                  {% endif %}
                </div>
              </div>
            </div>
            <div class="entry-content-cell">
              <header class="contribution-repository-head">
                <div class="contribution-repository-heading">
                  <h3 class="contribution-repository-title type-entry-title"><a href="{{ repository.url }}" title="{{ repository.name | escape }}" target="_blank" rel="noopener noreferrer">{{ repository.label | escape }}</a></h3>
                  <span class="contribution-repository-stars type-meta" role="img" aria-label="{{ repository.stars }} GitHub stars" title="{{ repository.stars }} GitHub stars">
                    <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="m8 1.25 2.086 4.226 4.664.678-3.375 3.29.797 4.647L8 11.897l-4.172 2.194.797-4.647L1.25 6.154l4.664-.678Z" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/></svg>{{ repository.starsLabel }}
                  </span>
                </div>
              </header>
              <p class="contribution-repository-intro type-body type-body--entry-description">{{ openSource.repositoryIntros[repository.name].text | escape }}</p>
              <p class="contribution-repository-summary type-body type-body--entry-description"><strong>Contributions:</strong> {{ repository.technicalSummary | escape }}</p>
              {% if repository.pullRequests.length %}
              <details class="contribution-disclosure">
                <summary class="contribution-toggle type-caption" aria-label="Selected PRs — {{ repository.label | escape }}"><svg class="contribution-toggle-arrow" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="m3 2 6 4-6 4Z"/></svg>Selected PRs</summary>
                <div class="contribution-topics">
                {% for topic in repository.topics %}
                <div class="contribution-topic">
                  <h4 class="contribution-topic-title type-group-label">{{ topic.title | escape }}</h4>
                  {% if topic.sequenceLabel %}<p class="contribution-topic-sequence type-caption">{{ topic.sequenceLabel | escape }}</p>{% endif %}
                <ul class="contribution-entries" aria-label="{{ topic.title | escape }} — {{ repository.label | escape }}">
                {% for pr in topic.pullRequests %}
                  <li class="contribution-entry" data-contribution-state="{{ pr.status }}" data-contribution-number="{{ pr.number }}">
                    <div class="contribution-content">
                      <p class="contribution-explanation type-body type-body--entry-description">{{ pr.mechanism | escape }} {{ pr.validation | escape }}</p>
                      <p class="contribution-description type-body type-body--entry-description"><span class="contribution-status contribution-status--{{ pr.status }}" role="img" aria-label="{{ pr.status | capitalize }}" title="{{ pr.status | capitalize }}">
                        {% if pr.status == "open" %}
                        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4 4.5v7M8 3h1a3 3 0 0 1 3 3v5.5M10 1l2 2-2 2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="4" cy="3" r="1.5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="4" cy="13" r="1.5" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="13" r="1.5" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
                        {% else %}
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M5.45 5.154A4.25 4.25 0 0 0 9.25 7.5h1.378a2.251 2.251 0 1 1 0 1.5H9.25A5.734 5.734 0 0 1 5 7.123v3.505a2.25 2.25 0 1 1-1.5 0V5.372a2.25 2.25 0 1 1 1.95-.218ZM4.25 13.5a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm8.5-4.5a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5ZM5 3.25a.75.75 0 1 0 0 .005V3.25Z"/></svg>
                        {% endif %}
                      </span><span class="contribution-text"><a class="contribution-pr-link" href="{{ pr.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ repository.label | escape }} PR #{{ pr.number }}: {{ pr.description | escape }} ({{ pr.status | capitalize }})" title="{{ pr.title | escape }}">#{{ pr.number }} {{ pr.linkLabel | escape }}</a>
                      </span></p>
                    </div>
                  </li>
                {% endfor %}
                </ul>
                </div>
                {% endfor %}
                </div>
              </details>
              {% endif %}
            </div>
          </article>
        {% else %}
          <p class="contributions-empty type-body">No selected technical contributions are currently open or merged.</p>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
