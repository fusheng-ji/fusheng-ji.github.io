{% import "components/ui.njk" as ui with context %}
<article class="section-table experience-entry career-entry" id="{{ experience.id }}">
  <div class="entry-media-cell">
    <div class="experience-logo-stack">
      {% for logo in experience.logos %}
        <div class="experience-logo-card">
          <img src="{{ logo.src }}" width="{{ logo.width }}" height="{{ logo.height }}" loading="lazy" decoding="async" alt="{{ logo.alt }}" class="{{ logo.className or '' }}">
        </div>
      {% endfor %}
    </div>
  </div>
  <div class="entry-content-cell">
    <div class="career-entry-header">
      <div class="split-row career-title-row">
        <h3 class="entry-title type-entry-title">{{ experience.title }}</h3>
        <span class="text-right experience-side-meta"><span class="entry-meta type-meta">{{ experience.date }}</span></span>
      </div>
      <div class="split-row experience-detail-row entry-type-row"><span class="experience-type type-meta type-meta--uppercase">{{ experience.type }}</span></div>
    </div>
    <div class="experience-content">
      <div class="entry-block">
        <h4 class="entry-label type-group-label">Contributions</h4>
        <ul class="entry-contrib type-body type-body--entry-description">
          {% for contribution in experience.contributions %}<li>{{ contribution | safe }}</li>{% endfor %}
        </ul>
      </div>
      {# Mentors temporarily hidden; keep markup and data for restoration.
      <div class="collab-section">
        <h4 class="collab-heading type-group-label">Mentors</h4>
        <div class="collab-list">
          {% for mentor in experience.mentors %}
            {% for person in mentor.people %}
              <div class="collab-row type-secondary">
                <span class="collab-name">
                  {% if person.url %}<a href="{{ person.url }}">{{ person.name }}</a>{% else %}{{ person.name }}{% endif %}
                </span>
              </div>
            {% endfor %}
          {% endfor %}
        </div>
      </div>
      #}
      {# Research topic badge temporarily hidden.
      <div class="entry-control-tag">{{ ui.researchTag(experience.area, researchAreas) }}</div>
      #}
    </div>
  </div>
</article>
